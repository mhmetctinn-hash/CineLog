PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://user:password@localhost:5432/cinelog

JWT_SECRET=

TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# Optional: error tracking. Leave empty to disable Sentry entirely.
SENTRY_DSN=

# Used to build password reset links (should be the frontend's base URL)
APP_URL=http://localhost:5173

# Optional: SMTP for sending password reset emails. Leave SMTP_HOST empty to
# just log the reset link to the console instead of sending an email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Cinelog <no-reply@cinelog.app>

# Email of the account that gets access to /admin. Leave empty to disable
# the admin panel for everyone.
ADMIN_EMAIL=

# Web push (browser notifications). Generate a pair with:
#   npx web-push generate-vapid-keys
# Leave empty to disable push (in-app notifications still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@cinelog.app

# Set to "false" to disable the daily watchlist-reminder / recommendation cron jobs
ENABLE_SCHEDULED_JOBS=true

# Shared secret for POST /api/internal/run-jobs (sent as the x-cron-secret
# header). Lets an external scheduler like GitHub Actions trigger the daily
# notification jobs even if this service is asleep on a free hosting tier.
# Generate one with: openssl rand -hex 32
CRON_SECRET=
